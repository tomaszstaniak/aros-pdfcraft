index 0000000000000000000000000000000000000000..034051eaec3786b74aedec6e89096c25998b8dbb
--- /dev/null
+++ b/crates/platform/src/paths.rs
@@ -0,0 +1,15 @@
+//! Native AROS volume prefixes at Unix Path-based automation boundaries.
+//! The program must use the SDK -nix startup so the resulting paths are usable.
+use std::path::{Path, PathBuf};
+
+/// Make a native `VOLUME:tail` absolute to Rust's Unix Path implementation.
+/// Keep parent components for the caller's confinement checks; never normalize
+/// them away here. Volume-relative and ambiguous prefixes fail closed.
+pub fn aros_to_unix(path: &Path) -> std::io::Result<PathBuf> {
+    let text = path.to_str().ok_or_else(|| std::io::Error::new(std::io::ErrorKind::InvalidInput, "non-UTF-8 automation path"))?;
+    let Some((volume, tail)) = text.split_once(':') else { return Ok(path.to_path_buf()) };
+    if volume.is_empty() || matches!(volume, "." | "..") || volume.contains(['/', '\\']) || tail.contains(':') {
+        return Err(std::io::Error::new(std::io::ErrorKind::InvalidInput, "ambiguous AROS volume path"));
+    }
+    Ok(PathBuf::from(format!("/{volume}/{}", tail.trim_start_matches('/'))))
+}
