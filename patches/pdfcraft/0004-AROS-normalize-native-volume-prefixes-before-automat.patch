 crates/platform/src/lib.rs           | 17 +++++++++++++++++
 crates/platform/src/paths.rs         | 15 +++++++++++++++
 crates/platform/src/staging.rs       |  9 +++++----
 5 files changed, 46 insertions(+), 4 deletions(-)
