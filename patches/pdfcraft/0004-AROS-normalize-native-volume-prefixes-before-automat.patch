+#[cfg(test)]
+mod aros_path_tests {
+    use std::path::Path;
+    #[test]
+    fn native_volume_paths_become_absolute_without_hiding_parent_steps() {
+        assert_eq!(super::paths::aros_to_unix(Path::new("RAM:pdfc/a.pdf")).unwrap(), Path::new("/RAM/pdfc/a.pdf"));
+        assert_eq!(super::paths::aros_to_unix(Path::new("RAM Disk:pdfc/a.pdf")).unwrap(), Path::new("/RAM Disk/pdfc/a.pdf"));
+        assert_eq!(super::paths::aros_to_unix(Path::new("RAM:../outside")).unwrap(), Path::new("/RAM/../outside"));
+        assert_eq!(super::paths::aros_to_unix(Path::new("relative.pdf")).unwrap(), Path::new("relative.pdf"));
+        assert_eq!(super::paths::aros_to_unix(Path::new("/RAM/pdfc")).unwrap(), Path::new("/RAM/pdfc"));
+        for invalid in [":relative-volume", "../RAM:outside", "RAM:other:file", ".:file", "..:file"] {
+            assert!(super::paths::aros_to_unix(Path::new(invalid)).is_err(), "{invalid}");
+        }
+    }
+}
