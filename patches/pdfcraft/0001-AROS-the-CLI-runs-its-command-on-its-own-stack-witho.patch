From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: tomaszstaniak <68373859+tomaszstaniak@users.noreply.github.com>
Date: Mon, 23 Nov 2026 15:56:56 +0100
Subject: [PATCH] AROS: the CLI runs its command on its own stack, without DOS
 requesters, and ends rayon's pool

---
 apps/pdfcraft-cli/Cargo.toml  |  7 +++++++
 apps/pdfcraft-cli/src/main.rs | 33 +++++++++++++++++++++++++++++++++
 2 files changed, 40 insertions(+)

diff --git a/apps/pdfcraft-cli/Cargo.toml b/apps/pdfcraft-cli/Cargo.toml
index ad4db521d5cac06c9c6e49f22be2a8de8525b802..3a3f92488179e6894e58ffe37738b827a0d2ca66 100644
--- a/apps/pdfcraft-cli/Cargo.toml
+++ b/apps/pdfcraft-cli/Cargo.toml
@@ -32,6 +32,13 @@ craft-image-codecs = { workspace = true }
 # Already in Cargo.lock through the GUI crates.
 rustix = { version = "1", features = ["process"] }
 
+# The patched rayon-core (see the AROS port's crate patches) can end the global pool's threads,
+# which AROS's pthread library otherwise waits for forever when the program exits. Program start
+# on AROS (from the egui-aros repository, without egui), supplied by the port's build.
+[target.'cfg(target_os = "aros")'.dependencies]
+rayon-core = "1.13"
+aros-startup = "0.1"
+
 [build-dependencies]
 # VERSIONINFO for pdfcraft-cli.exe; build.rs only uses it when targeting Windows.
 winresource = "0.1"
diff --git a/apps/pdfcraft-cli/src/main.rs b/apps/pdfcraft-cli/src/main.rs
index 9158d5e6f2d234fb1a3e0ecc9e1b8c5732d79224..ef656df1e870036b1413dfbf3865226767d29fbe 100644
--- a/apps/pdfcraft-cli/src/main.rs
+++ b/apps/pdfcraft-cli/src/main.rs
@@ -97,12 +97,45 @@ pdfcraft-cli ui     --control FILE <method> [key=value …] [--out shot.png]
 help and feedback: https://discord.gg/artcraft"
 );
 
+/// The command thread's stack on AROS (see `main`).
+#[cfg(target_os = "aros")]
+const AROS_STACK: usize = 8 << 20;
+
 fn main() -> ExitCode {
     // Before anything uses aws-lc: an `OPENSSL_ia32cap` naming a CPU feature this processor lacks
     // would stop it, so the CLI runs again without it (#2916, `pdfcraft_platform::crypto_env`).
     if let Some(code) = pdfcraft_platform::crypto_env::run_without_cpu_override() {
         std::process::exit(code);
     }
+    // AROS: Unix-style probes (chrono's /etc/localtime for local time, the /etc and /usr font
+    // folders) name volumes that do not exist; DOS answers them with an error instead of an
+    // "insert volume" requester that stops the command until someone answers it.
+    #[cfg(target_os = "aros")]
+    aros_startup::quiet_dos();
+    #[cfg(not(target_os = "aros"))]
+    let code = cli_main();
+    // An AROS program runs on the stack of whatever starts it: 40,960 bytes in an AROS One
+    // Shell, and whatever an MCP client's process creation gives. Parsing, layout and rendering
+    // overrun that, and the overrun takes the system down with it. The command runs on a thread
+    // with its own stack, so no caller has to know the size; the exit code comes back to the main
+    // task, because ending the process from another thread crashes on AROS.
+    #[cfg(target_os = "aros")]
+    let code = std::thread::Builder::new()
+        .name("pdfcraft-cli".into())
+        .stack_size(AROS_STACK)
+        .spawn(cli_main)
+        .map_err(|e| eprintln!("pdfcraft-cli: {e}"))
+        .and_then(|worker| worker.join().map_err(|_| eprintln!("pdfcraft-cli: the command panicked")))
+        .unwrap_or(ExitCode::FAILURE);
+    // AROS's pthread library joins every thread in its exit handler; rayon's idle global workers
+    // (OpenEXR pictures are decoded on them) never end by themselves, so a command that used them
+    // could not exit.
+    #[cfg(target_os = "aros")]
+    rayon_core::terminate_global_thread_pool();
+    code
+}
+
+fn cli_main() -> ExitCode {
     // aws-lc detects the CPU's features here, where it used to before `main` (`init_crypto`).
     pdfcraft_engine::sign::init_crypto();
     // `std::env::args` panics on an argument that is not UTF-8 ("called `Result::unwrap()` on an
