new file mode 100644
index 0000000000000000000000000000000000000000..c4b89b826aa8b20d4b4b61e062200015bf8d119b
--- /dev/null
+++ b/apps/pdfcraft-aros/src/wake.rs
@@ -0,0 +1,60 @@
+//! A repaint callback may outlive the UI. Disable its opaque native handle
+//! before destroying the window, waiting for any in-flight signal call.
+use std::sync::Mutex;
+
+pub struct Wake {
+    handle: Mutex<Option<usize>>,
+}
+impl Wake {
+    pub fn new(handle: usize) -> Self {
+        Self { handle: Mutex::new(Some(handle)) }
+    }
+    pub fn with_live(&self, signal: impl FnOnce(usize)) {
+        let handle = self.handle.lock().unwrap_or_else(std::sync::PoisonError::into_inner);
+        if let Some(handle) = *handle {
+            signal(handle);
+        }
+    }
+    pub fn disable(&self) {
+        self.handle.lock().unwrap_or_else(std::sync::PoisonError::into_inner).take();
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::Wake;
+    use std::sync::{
+        Arc,
+        atomic::{AtomicBool, AtomicUsize, Ordering},
+    };
+    #[test]
+    fn late_workers_cannot_use_a_destroyed_window_handle() {
+        let wake = Arc::new(Wake::new(7));
+        let closed = Arc::new(AtomicBool::new(false));
+        let calls = Arc::new(AtomicUsize::new(0));
+        wake.with_live(|handle| assert_eq!(handle, 7));
+        let mut workers = Vec::new();
+        for _ in 0..4 {
+            let (wake, closed, calls) = (wake.clone(), closed.clone(), calls.clone());
+            workers.push(std::thread::spawn(move || {
+                for _ in 0..1000 {
+                    wake.with_live(|handle| {
+                        assert_eq!(handle, 7);
+                        assert!(!closed.load(Ordering::SeqCst));
+                        calls.fetch_add(1, Ordering::SeqCst);
+                    });
+                }
+            }));
+        }
+        wake.disable();
+        closed.store(true, Ordering::SeqCst);
+        for worker in workers {
+            worker.join().unwrap();
+        }
+        let before = calls.load(Ordering::SeqCst);
+        wake.with_live(|_| {
+            calls.fetch_add(1, Ordering::SeqCst);
+        });
+        assert_eq!(before, calls.load(Ordering::SeqCst));
+    }
+}
