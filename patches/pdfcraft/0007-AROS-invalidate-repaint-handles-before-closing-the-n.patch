From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: tomaszstaniak <68373859+tomaszstaniak@users.noreply.github.com>
Date: Sun, 18 Oct 2026 12:04:18 +0200
Subject: [PATCH] AROS: invalidate repaint handles before closing the native
 window

PdfCraft background contexts may outlive the app. Replace the copied raw-pointer Send/Sync waker with reference-counted state whose mutex covers Signal and invalidation. Window drop waits for an in-flight wake and disables future ones before freeing C storage. Host late-worker regression passes; native close remains to be exercised.
---
 apps/pdfcraft-aros/src/ffi.rs  | 30 ++++++++---------
 apps/pdfcraft-aros/src/main.rs |  1 +
 apps/pdfcraft-aros/src/wake.rs | 60 ++++++++++++++++++++++++++++++++++
 3 files changed, 76 insertions(+), 15 deletions(-)
 create mode 100644 apps/pdfcraft-aros/src/wake.rs

diff --git a/apps/pdfcraft-aros/src/ffi.rs b/apps/pdfcraft-aros/src/ffi.rs
index daf9b674ecb264b2d9c02e084dd2015912d9bbd0..616b5fe3ef23151b18648c29c1d1e4545c2771aa 100644
--- a/apps/pdfcraft-aros/src/ffi.rs
+++ b/apps/pdfcraft-aros/src/ffi.rs
@@ -179,22 +179,21 @@ pub fn screen_size() -> (i32, i32) {
 /// The shell's window. Lives on the main thread; only [`Waker`] crosses threads.
 pub struct Window {
     raw: *mut WcWindow,
+    wake: std::sync::Arc<crate::wake::Wake>,
 }
 
-/// Wakes the event loop from another thread (egui's repaint requests from workers).
-#[derive(Clone, Copy)]
-pub struct Waker(*mut WcWindow);
-
-// SAFETY: wc_window_wake only raises an exec signal for the main task, which is safe from any
-// task; the pointer is never dereferenced on the other thread beyond that call, and the window
-// outlives every worker that holds a waker (the app, and its workers, are dropped before it).
-unsafe impl Send for Waker {}
-unsafe impl Sync for Waker {}
-
+/// Repaint token that can safely outlive the UI and its native window.
+#[derive(Clone)]
+pub struct Waker(std::sync::Arc<crate::wake::Wake>);
 impl Waker {
     pub fn wake(&self) {
-        // SAFETY: see the Send impl.
-        unsafe { wc_window_wake(self.0) }
+        self.0.with_live(|handle| {
+            // SAFETY: Window::drop disables this state before freeing the C window.
+            // The state mutex stays held through Signal(), so close cannot race it.
+            unsafe {
+                wc_window_wake(handle as *mut WcWindow);
+            }
+        });
     }
 }
 
@@ -203,11 +202,11 @@ impl Window {
         let title = text_cstring(title);
         // SAFETY: the title outlives the call (the C side copies it).
         let raw = unsafe { wc_window_open(width, height, title.as_ptr()) };
-        if raw.is_null() { None } else { Some(Self { raw }) }
+        if raw.is_null() { None } else { Some(Self { raw, wake: std::sync::Arc::new(crate::wake::Wake::new(raw as usize)) }) }
     }
 
     pub fn waker(&self) -> Waker {
-        Waker(self.raw)
+        Waker(self.wake.clone())
     }
 
     pub fn inner_size(&self) -> (i32, i32) {
@@ -286,7 +285,8 @@ impl Window {
 
 impl Drop for Window {
     fn drop(&mut self) {
-        // SAFETY: closed exactly once.
+        self.wake.disable();
+        // SAFETY: closed exactly once, after every in-flight wake has finished.
         unsafe { wc_window_close(self.raw) }
     }
 }
