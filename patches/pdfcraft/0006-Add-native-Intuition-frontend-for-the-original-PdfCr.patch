+use pdfcraft_aros_clipboard::{Clipboard, install};
+#[test]
+fn text_uses_native_handlers_and_unsupported_image_copy_is_an_error() {
+    assert!(Clipboard::new().is_err());
+    install(|| Some("native text".into()), |text| text == "new text").unwrap();
+    let mut clipboard = Clipboard::new().unwrap();
+    assert_eq!(clipboard.get_text().unwrap(), "native text");
+    clipboard.set_text("new text").unwrap();
+    assert!(clipboard.get_image().is_err());
+    assert!(clipboard.set().file_list(&[std::path::Path::new("x")]).is_err());
+}
