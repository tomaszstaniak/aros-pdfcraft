+//! Text clipboard callbacks from the AROS shell. Image and file-list APIs
+//! return explicit errors until native support is implemented and tested.
+use std::borrow::Cow;
+use std::path::Path;
+use std::sync::OnceLock;
+#[derive(Debug)]
+pub struct Error(&'static str);
+impl std::fmt::Display for Error {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.write_str(self.0)
+    }
+}
+impl std::error::Error for Error {}
+struct Handlers {
+    read: fn() -> Option<String>,
+    write: fn(&str) -> bool,
+}
+static HANDLERS: OnceLock<Handlers> = OnceLock::new();
+pub fn install(read: fn() -> Option<String>, write: fn(&str) -> bool) -> Result<(), &'static str> {
+    HANDLERS.set(Handlers { read, write }).map_err(|_| "clipboard handlers already installed")
+}
+pub struct Clipboard;
+pub struct ImageData<'a> {
+    pub width: usize,
+    pub height: usize,
+    pub bytes: Cow<'a, [u8]>,
+}
+pub struct Set<'a>(&'a mut Clipboard);
+impl Clipboard {
+    pub fn new() -> Result<Self, Error> {
+        HANDLERS.get().map(|_| Self).ok_or(Error("native clipboard not initialized"))
+    }
+    pub fn get_text(&mut self) -> Result<String, Error> {
+        HANDLERS.get().and_then(|h| (h.read)()).ok_or(Error("clipboard contains no text"))
+    }
+    pub fn set_text(&mut self, text: impl AsRef<str>) -> Result<(), Error> {
+        if HANDLERS.get().is_some_and(|h| (h.write)(text.as_ref())) { Ok(()) } else { Err(Error("cannot write clipboard text")) }
+    }
+    pub fn get_image(&mut self) -> Result<ImageData<'static>, Error> {
+        Err(Error("AROS image clipboard is not implemented"))
+    }
+    pub fn set_image(&mut self, _image: ImageData<'_>) -> Result<(), Error> {
+        Err(Error("AROS image clipboard is not implemented"))
+    }
+    pub fn set(&mut self) -> Set<'_> {
+        Set(self)
+    }
+}
+impl Set<'_> {
+    pub fn file_list(self, _paths: &[impl AsRef<Path>]) -> Result<(), Error> {
+        let _ = self.0;
+        Err(Error("AROS clipboard file lists are not implemented"))
+    }
+}
