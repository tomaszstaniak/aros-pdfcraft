@@ -0,0 +1,82 @@
+use crate::ffi;
+use pdfcraft_aros_dialog::{Kind, Request};
+use std::cell::RefCell;
+use std::path::PathBuf;
+use std::rc::Rc;
+pub type SharedWindow = Rc<RefCell<Option<Rc<ffi::Window>>>>;
+thread_local! { static WINDOW: RefCell<Option<SharedWindow>> = const { RefCell::new(None) }; }
+
+pub fn install(window: SharedWindow) {
+    WINDOW.with(|slot| *slot.borrow_mut() = Some(window));
+    let _ = pdfcraft_aros_dialog::install(request);
+    let _ = pdfcraft_aros_clipboard::install(read_clipboard, write_clipboard);
+}
+fn request(request: Request) -> Option<Vec<PathBuf>> {
+    WINDOW.with(|slot| {
+        let shared = slot.borrow().clone()?;
+        let window = shared.borrow().clone()?;
+        let pattern = request
+            .filters
+            .first()
+            .map(|(_, exts)| if exts.iter().any(|s| s == "*") { "#?".to_owned() } else { format!("#?.({})", exts.join("|")) })
+            .unwrap_or_default();
+        let unix_dir = request.directory.to_string_lossy();
+        let mut dir = match unix_dir.strip_prefix('/') {
+            Some(rest) => {
+                let (volume, tail) = rest.split_once('/').unwrap_or((rest, ""));
+                format!("{volume}:{tail}")
+            }
+            None => unix_dir.into_owned(),
+        };
+        let mut file = request.file_name.clone();
+        if dir.is_empty() && !ffi::dir_part(&file).is_empty() {
+            let suggested_dir = ffi::dir_part(&file).to_owned();
+            let suggested_file = ffi::file_part(&file).to_owned();
+            dir = match suggested_dir.strip_prefix('/') {
+                Some(rest) => {
+                    let (volume, tail) = rest.split_once('/').unwrap_or((rest, ""));
+                    format!("{volume}:{tail}")
+                }
+                None => suggested_dir,
+            };
+            file = suggested_file;
+        }
+        let selected = if request.kind == Kind::Folder {
+            window.folder_request(&request.title, &dir)
+        } else {
+            window.file_request(request.kind == Kind::Save, request.kind == Kind::Many, &request.title, &dir, &file, &pattern)
+        };
+        let mut paths = Vec::new();
+        for path in selected {
+            match pdfcraft_platform::paths::aros_to_unix(std::path::Path::new(&path)) {
+                Ok(path) => paths.push(path),
+                Err(error) => {
+                    log::warn!("ASL path: {error}");
+                    return None;
+                }
+            }
+        }
+        Some(paths)
+    })
+}
+
+fn read_clipboard() -> Option<String> {
+    WINDOW.with(|slot| {
+        let shared = slot.borrow().clone()?;
+        if shared.borrow().is_none() {
+            return None;
+        }
+        ffi::clipboard_read_text()
+    })
+}
+fn write_clipboard(text: &str) -> bool {
+    WINDOW.with(|slot| {
+        let Some(shared) = slot.borrow().clone() else {
+            return false;
+        };
+        if shared.borrow().is_none() {
+            return false;
+        }
+        ffi::clipboard_write_text(text)
+    })
+}
