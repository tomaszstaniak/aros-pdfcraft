diff --git a/apps/pdfcraft-aros/build.rs b/apps/pdfcraft-aros/build.rs
new file mode 100644
index 0000000000000000000000000000000000000000..41596e70d9bcb5603e1f0e76149d7c2cab2ac9af
--- /dev/null
+++ b/apps/pdfcraft-aros/build.rs
@@ -0,0 +1,54 @@
+//! Compiles the C side of the shell (`c/aros_shell.c`) with the AROS C cross compiler and links
+//! it in. The compiler and archiver come from `AROS_CC` (or `AROS_GCC`) / `AROS_AR` (the AROS
+//! build system sets them), else `<arch>-aros-cc` / `<arch>-aros-ar` on the PATH (what the Rust
+//! crosstool installs). `AROS_SDK`, when set, is passed as `--sysroot`: the C glue must see the
+//! same SDK headers as the final link, because ABIv1 and ABIv11 inline library calls differently
+//! and a mismatch fails inside the first system call rather than at build time.
+//! On any other target the file is skipped, so the workspace still type-checks on the host.
+
+use std::path::PathBuf;
+use std::process::Command;
+
+fn main() {
+    println!("cargo:rerun-if-changed=c/aros_shell.c");
+    println!("cargo:rerun-if-env-changed=AROS_CC");
+    println!("cargo:rerun-if-env-changed=AROS_AR");
+    println!("cargo:rerun-if-env-changed=AROS_GCC");
+    println!("cargo:rerun-if-env-changed=AROS_SDK");
+    let os = std::env::var("CARGO_CFG_TARGET_OS").unwrap_or_default();
+    if os != "aros" {
+        return;
+    }
+    let arch = std::env::var("CARGO_CFG_TARGET_ARCH").unwrap_or_default();
+    let cc = std::env::var("AROS_CC").or_else(|_| std::env::var("AROS_GCC")).unwrap_or_else(|_| format!("{arch}-aros-cc"));
+    let ar = std::env::var("AROS_AR").unwrap_or_else(|_| format!("{arch}-aros-ar"));
+    let out = PathBuf::from(std::env::var("OUT_DIR").unwrap_or_default());
+    let obj = out.join("aros_shell.o");
+    let lib = out.join("libpdfcraft_aros_shell.a");
+    let mut compile = Command::new(&cc);
+    if let Ok(sdk) = std::env::var("AROS_SDK") {
+        compile.arg(format!("--sysroot={sdk}"));
+    }
+    let status = compile.args(["-O2", "-Wall", "-Wno-unused-function", "-c", "c/aros_shell.c", "-o"]).arg(&obj).status();
+    match status {
+        Ok(s) if s.success() => {}
+        Ok(s) => panic_build(&format!("{cc} failed with {s}")),
+        Err(e) => panic_build(&format!("cannot run {cc}: {e}")),
+    }
+    let _ = std::fs::remove_file(&lib);
+    let status = Command::new(&ar).arg("crs").arg(&lib).arg(&obj).status();
+    match status {
+        Ok(s) if s.success() => {}
+        Ok(s) => panic_build(&format!("{ar} failed with {s}")),
+        Err(e) => panic_build(&format!("cannot run {ar}: {e}")),
+    }
+    println!("cargo:rustc-link-search=native={}", out.display());
+    println!("cargo:rustc-link-lib=static=pdfcraft_aros_shell");
+}
+
+/// A build script reports its failure through its exit status; this is the one place a panic
+/// is the right tool.
+#[allow(clippy::panic)]
+fn panic_build(msg: &str) -> ! {
+    panic!("pdfcraft-aros build.rs: {msg}");
+}
diff --git a/apps/pdfcraft-aros/c/aros_shell.c b/apps/pdfcraft-aros/c/aros_shell.c
new file mode 100644
index 0000000000000000000000000000000000000000..26599d08403295111a4d8f37913a4bc32e1275b6
--- /dev/null
+++ b/apps/pdfcraft-aros/c/aros_shell.c
@@ -0,0 +1,648 @@
+/*
+ * aros_shell.c - the AROS side of PdfCraft's shell.
+ *
+ * One Intuition window on the default public screen, its IDCMP events
+ * translated into plain records the Rust event loop (src/ffi.rs) reads, the
+ * egui frame buffer blitted into it with cybergraphics, keys mapped through
+ * keymap.library, ASL file requesters, the FTXT clipboard through iffparse,
+ * and a timer.device request so the event loop can sleep until egui's next
+ * repaint is due. Everything the Rust side needs is a C function taking the
+ * handle returned by wc_window_open(); library bases come from the AROS
+ * autoinit link libraries.
+ */
+
+#include <proto/exec.h>
+#include <proto/dos.h>
+#include <proto/intuition.h>
+#include <proto/graphics.h>
+#include <proto/cybergraphics.h>
+#include <proto/keymap.h>
+#include <proto/asl.h>
+#include <proto/iffparse.h>
+#include <proto/utility.h>
+
+#include <exec/memory.h>
+#include <dos/dosextens.h>
+#include <exec/ports.h>
+#include <exec/execbase.h>
+#include <stdio.h>
+#include <intuition/intuition.h>
+#include <intuition/screens.h>
+#include <cybergraphx/cybergraphics.h>
+#include <devices/inputevent.h>
+#include <devices/rawkeycodes.h>
+#include <devices/timer.h>
+#include <libraries/asl.h>
+#include <libraries/iffparse.h>
+#include <workbench/startup.h>
+
+#include <stdint.h>
+#include <stdlib.h>
+#include <string.h>
+
+#define ID_FTXT MAKE_ID('F', 'T', 'X', 'T')
+#define ID_CHRS MAKE_ID('C', 'H', 'R', 'S')
+
+/* Event kinds, mirrored in src/ffi.rs. */
+enum wc_event_kind {
+    WC_EV_NONE = 0,
+    WC_EV_CLOSE = 1,
+    WC_EV_RESIZE = 2,
+    WC_EV_MOUSE_MOVE = 3,
+    WC_EV_BUTTON = 4,
+    WC_EV_KEY = 5,
+    WC_EV_WHEEL = 6,
+    WC_EV_FOCUS = 7,
+    WC_EV_REFRESH = 8,
+};
+
+/* One translated IDCMP message, mirrored in src/ffi.rs (keep the layout in sync). */
+struct wc_event {
+    int32_t kind;
+    int32_t x, y;          /* pointer position in inner-window pixels */
+    int32_t button;        /* WC_EV_BUTTON: 0 left, 1 right, 2 middle */
+    int32_t down;          /* WC_EV_BUTTON / WC_EV_KEY: pressed */
+    int32_t rawkey;        /* WC_EV_KEY: RAWKEY_* code */
+    uint32_t qualifier;    /* IEQUALIFIER_* at the time of the event */
+    int32_t wheel_x, wheel_y; /* WC_EV_WHEEL: steps, right and up positive */
+    int32_t width, height; /* WC_EV_RESIZE: the new inner size */
+    int32_t focus;         /* WC_EV_FOCUS: 1 activated, 0 deactivated */
+    char text[16];         /* WC_EV_KEY: the key with its qualifiers (system charset), NUL ended */
+    char plain[8];         /* WC_EV_KEY: the key with no qualifiers, for the logical key name */
+    uint32_t secs, micros; /* the message's system time (IntuiMessage Seconds/Micros) */
+};
+
+struct wc_window {
+    struct Window *win;
+    struct MsgPort *timer_port;
+    struct timerequest *timer_req;
+    int timer_open;
+    int timer_pending;
+    struct Task *task;
+    LONG wake_sig;         /* signal other threads raise to wake the event loop */
+    char title[256];
+    uint32_t qualifier;    /* last seen qualifiers (Caps Lock state for the app) */
+};
+
+static void stop_timer(struct wc_window *w)
+{
+    if (w->timer_pending) {
+        if (!CheckIO((struct IORequest *)w->timer_req))
+            AbortIO((struct IORequest *)w->timer_req);
+        WaitIO((struct IORequest *)w->timer_req);
+        w->timer_pending = 0;
+    }
+}
+
+static void start_timer(struct wc_window *w, int ms)
+{
+    stop_timer(w);
+    if (!w->timer_open || ms <= 0)
+        return;
+    w->timer_req->tr_node.io_Command = TR_ADDREQUEST;
+    w->timer_req->tr_time.tv_secs = ms / 1000;
+    w->timer_req->tr_time.tv_micro = (ms % 1000) * 1000;
+    SendIO((struct IORequest *)w->timer_req);
+    w->timer_pending = 1;
+}
+
+/* The public screen's size, for placing and limiting the window. */
+void wc_screen_size(int32_t *width, int32_t *height)
+{
+    struct Screen *scr = LockPubScreen(NULL);
+    *width = 1024;
+    *height = 768;
+    if (scr) {
+        *width = scr->Width;
+        *height = scr->Height;
+        UnlockPubScreen(NULL, scr);
+    }
+}
+
+struct wc_window *wc_window_open(int32_t width, int32_t height, const char *title)
+{
+    struct wc_window *w = calloc(1, sizeof *w);
+    int32_t sw, sh;
+    if (!w)
+        return NULL;
+    strncpy(w->title, title ? title : "PdfCraft", sizeof w->title - 1);
+    w->task = FindTask(NULL);
+    w->wake_sig = AllocSignal(-1);
+    if (w->wake_sig >= 0)
+        SetSignal(0, 1UL << w->wake_sig);
+
+    wc_screen_size(&sw, &sh);
+    if (width > sw - 16) width = sw - 16;
+    if (height > sh - 48) height = sh - 48;
+    if (width < 320) width = 320;
+    if (height < 240) height = 240;
+
+    w->win = OpenWindowTags(NULL,
+        WA_Left, (sw - width) / 2 > 0 ? (sw - width) / 2 : 0,
+        WA_Top, (sh - height) / 2 > 0 ? (sh - height) / 2 : 0,
+        WA_InnerWidth, width,
+        WA_InnerHeight, height,
+        WA_MinWidth, 320,
+        WA_MinHeight, 240,
+        WA_MaxWidth, ~0,
+        WA_MaxHeight, ~0,
+        WA_Title, (IPTR)w->title,
+        WA_Flags, WFLG_DRAGBAR | WFLG_DEPTHGADGET | WFLG_CLOSEGADGET | WFLG_SIZEGADGET
+                | WFLG_SIZEBBOTTOM | WFLG_ACTIVATE | WFLG_REPORTMOUSE | WFLG_RMBTRAP
+                | WFLG_GIMMEZEROZERO | WFLG_NOCAREREFRESH,
+        WA_IDCMP, IDCMP_CLOSEWINDOW | IDCMP_NEWSIZE | IDCMP_MOUSEBUTTONS | IDCMP_MOUSEMOVE
+                | IDCMP_RAWKEY | IDCMP_ACTIVEWINDOW | IDCMP_INACTIVEWINDOW,
+        TAG_DONE);
+    if (!w->win) {
+        if (w->wake_sig >= 0) FreeSignal(w->wake_sig);
+        free(w);
+        return NULL;
+    }
+
+    w->timer_port = CreateMsgPort();
+    if (w->timer_port) {
+        SetSignal(0, 1UL << w->timer_port->mp_SigBit);
+        w->timer_req = (struct timerequest *)CreateIORequest(w->timer_port, sizeof(struct timerequest));
+        if (w->timer_req && OpenDevice((CONST_STRPTR)"timer.device", UNIT_MICROHZ, (struct IORequest *)w->timer_req, 0) == 0)
+            w->timer_open = 1;
+    }
+    return w;
+}
+
+void wc_window_close(struct wc_window *w)
+{
+    if (!w)
+        return;
+    stop_timer(w);
+    if (w->timer_open)
+        CloseDevice((struct IORequest *)w->timer_req);
+    if (w->timer_req)
+        DeleteIORequest((struct IORequest *)w->timer_req);
+    if (w->timer_port)
+        DeleteMsgPort(w->timer_port);
+    if (w->win)
+        CloseWindow(w->win);
+    if (w->wake_sig >= 0)
+        FreeSignal(w->wake_sig);
+    free(w);
+}
+
+void wc_window_inner_size(struct wc_window *w, int32_t *width, int32_t *height)
+{
+    *width = w->win->GZZWidth;
+    *height = w->win->GZZHeight;
+}
+
+/* Sleeps until a window message, a wake-up from wc_window_wake() or the
+ * timeout (milliseconds; negative waits for messages only). Returns 1 when a
+ * window message or wake-up arrived, 0 on timeout. The timer is judged by its
+ * request (CheckIO), never by its signal alone: a signal bit can be left set
+ * from an earlier use, and that must not count as a timeout. */
+int32_t wc_window_wait(struct wc_window *w, int32_t timeout_ms)
+{
+    ULONG winsig = 1UL << w->win->UserPort->mp_SigBit;
+    ULONG wakesig = w->wake_sig >= 0 ? 1UL << w->wake_sig : 0;
+    ULONG timersig = 0;
+    ULONG got;
+
+    /* egui wants the next frame at once: still block for a moment so the
+     * other tasks run (the file-open and save workers, the font scan); a
+     * frame loop that never waits starves them. A millisecond is nothing
+     * next to a software-rendered frame. */
+    if (timeout_ms == 0)
+        timeout_ms = w->timer_open ? 1 : 0;
+    if (timeout_ms == 0)
+        return 1;
+    if (w->timer_open && timeout_ms > 0) {
+        start_timer(w, timeout_ms);
+        timersig = 1UL << w->timer_port->mp_SigBit;
+    }
+    for (;;) {
+        got = Wait(winsig | wakesig | timersig);
+        if (got & (winsig | wakesig)) {
+            stop_timer(w);
+            return 1;
+        }
+        if (w->timer_pending && CheckIO((struct IORequest *)w->timer_req)) {
+            WaitIO((struct IORequest *)w->timer_req);
+            w->timer_pending = 0;
+            return 0;
+        }
+        if (!timersig)
+            return 1;
+        /* a stale timer signal: the request is still running, keep waiting */
+    }
+}
+
+/* The system time in the clock IntuiMessages are stamped with, for measuring
+ * how long an event waited until its frame was shown. */
+void wc_systime(uint32_t *secs, uint32_t *micros)
+{
+    ULONG s = 0, m = 0;
+    CurrentTime(&s, &m);
+    *secs = s;
+    *micros = m;
+}
+
+/* Wakes the event loop from any task (egui's request_repaint from a worker thread). */
+void wc_window_wake(struct wc_window *w)
+{
+    if (w && w->wake_sig >= 0)
+        Signal(w->task, 1UL << w->wake_sig);
+}
+
+static void map_key(struct wc_window *w, struct IntuiMessage *imsg, struct wc_event *ev)
+{
+    struct InputEvent ie;
+    UWORD code = imsg->Code & ~IECODE_UP_PREFIX;
+    LONG n;
+
+    memset(&ie, 0, sizeof ie);
+    ie.ie_Class = IECLASS_RAWKEY;
+    ie.ie_Code = code;
+    /* Control and Amiga combinations map to control characters; the app wants
+     * the plain key under them, so those qualifiers are left out here. */
+    ie.ie_Qualifier = imsg->Qualifier & ~(IEQUALIFIER_CONTROL | IEQUALIFIER_LCOMMAND | IEQUALIFIER_RCOMMAND);
+    if (imsg->IAddress)
+        ie.ie_EventAddress = (APTR *)*((IPTR *)imsg->IAddress);
+    n = MapRawKey(&ie, (STRPTR)ev->text, sizeof ev->text - 1, NULL);
+    if (n < 0) n = 0;
+    ev->text[n] = 0;
+
+    ie.ie_Qualifier = 0;
+    ie.ie_EventAddress = NULL;
+    n = MapRawKey(&ie, (STRPTR)ev->plain, sizeof ev->plain - 1, NULL);
+    if (n < 0) n = 0;
+    ev->plain[n] = 0;
+    (void)w;
+}
+
+/* Fills the next translated event; returns 0 when there is none waiting. */
+int32_t wc_window_poll(struct wc_window *w, struct wc_event *ev)
+{
+    struct IntuiMessage *imsg;
+
+    memset(ev, 0, sizeof *ev);
+    while ((imsg = (struct IntuiMessage *)GetMsg(w->win->UserPort))) {
+        ULONG cls = imsg->Class;
+        UWORD code = imsg->Code;
+        UWORD qual = imsg->Qualifier;
+        /* The message's position is relative to the outer window; the frame is the
+         * GimmeZeroZero inner area, which starts after the borders. */
+        WORD mx = imsg->MouseX - w->win->BorderLeft, my = imsg->MouseY - w->win->BorderTop;
+
+        w->qualifier = qual;
+        ev->x = mx;
+        ev->y = my;
+        ev->qualifier = qual;
+        ev->secs = imsg->Seconds;
+        ev->micros = imsg->Micros;
+
+        switch (cls) {
+        case IDCMP_CLOSEWINDOW:
+            ReplyMsg((struct Message *)imsg);
+            ev->kind = WC_EV_CLOSE;
+            return 1;
+        case IDCMP_NEWSIZE:
+            ReplyMsg((struct Message *)imsg);
+            ev->kind = WC_EV_RESIZE;
+            ev->width = w->win->GZZWidth;
+            ev->height = w->win->GZZHeight;
+            return 1;
+        case IDCMP_MOUSEMOVE:
+            ReplyMsg((struct Message *)imsg);
+            ev->kind = WC_EV_MOUSE_MOVE;
+            return 1;
+        case IDCMP_MOUSEBUTTONS:
+            ReplyMsg((struct Message *)imsg);
+            ev->kind = WC_EV_BUTTON;
+            ev->down = (code & IECODE_UP_PREFIX) ? 0 : 1;
+            switch (code & ~IECODE_UP_PREFIX) {
+            case IECODE_LBUTTON: ev->button = 0; break;
+            case IECODE_RBUTTON: ev->button = 1; break;
+            case IECODE_MBUTTON: ev->button = 2; break;
+            default: ev->kind = WC_EV_NONE; continue;
+            }
+            return 1;
+        case IDCMP_RAWKEY: {
+            UWORD key = code & ~IECODE_UP_PREFIX;
+            if (key >= RAWKEY_NM_WHEEL_UP && key <= RAWKEY_NM_WHEEL_RIGHT) {
+                ReplyMsg((struct Message *)imsg);
+                if (code & IECODE_UP_PREFIX)
+                    continue;
+                ev->kind = WC_EV_WHEEL;
+                switch (key) {
+                case RAWKEY_NM_WHEEL_UP: ev->wheel_y = 1; break;
+                case RAWKEY_NM_WHEEL_DOWN: ev->wheel_y = -1; break;
+                case RAWKEY_NM_WHEEL_LEFT: ev->wheel_x = -1; break;
+                default: ev->wheel_x = 1; break;
+                }
+                return 1;
+            }
+            ev->kind = WC_EV_KEY;
+            ev->rawkey = key;
+            ev->down = (code & IECODE_UP_PREFIX) ? 0 : 1;
+            if (ev->down)
+                map_key(w, imsg, ev);
+            ReplyMsg((struct Message *)imsg);
+            return 1;
+        }
+        case IDCMP_ACTIVEWINDOW:
+        case IDCMP_INACTIVEWINDOW:
+            ReplyMsg((struct Message *)imsg);
+            ev->kind = WC_EV_FOCUS;
+            ev->focus = cls == IDCMP_ACTIVEWINDOW;
+            return 1;
+        default:
+            ReplyMsg((struct Message *)imsg);
+            continue;
+        }
+    }
+    return 0;
+}
+
+uint32_t wc_window_qualifier(struct wc_window *w)
+{
+    return w->qualifier;
+}
+
+/* Copies an RGBA (byte order R, G, B, A) frame buffer into the window's inner area. */
+void wc_window_blit(struct wc_window *w, const uint8_t *rgba, int32_t width, int32_t height, int32_t stride)
+{
+    int32_t iw = w->win->GZZWidth, ih = w->win->GZZHeight;
+    if (width > iw) width = iw;
+    if (height > ih) height = ih;
+    if (width <= 0 || height <= 0)
+        return;
+    WritePixelArray((APTR)rgba, 0, 0, stride, w->win->RPort, 0, 0, width, height, RECTFMT_RGBA);
+}
+
+void wc_window_set_busy(struct wc_window *w, int32_t busy)
+{
+    SetWindowPointer(w->win, WA_BusyPointer, busy ? TRUE : FALSE, TAG_DONE);
+}
+
+void wc_window_set_title(struct wc_window *w, const char *title)
+{
+    strncpy(w->title, title ? title : "", sizeof w->title - 1);
+    w->title[sizeof w->title - 1] = 0;
+    SetWindowTitles(w->win, (CONST_STRPTR)w->title, (CONST_STRPTR)~0);
+}
+
+void wc_window_activate(struct wc_window *w)
+{
+    ActivateWindow(w->win);
+}
+
+/* The event loop's task priority. A task that keeps the CPU is not time-sliced
+ * against equal-priority tasks on every AROS flavour, so while background
+ * work runs (file opens and saves, the font scan) the loop drops below the
+ * workers' priority 0 and only draws when they wait. */
+void wc_window_set_priority(struct wc_window *w, int32_t pri)
+{
+    SetTaskPri(w->task, pri);
+}
+
+void wc_beep(void)
+{
+    DisplayBeep(NULL);
+}
+
+/*
+ * The requester's drawer as an absolute path in `buf`. ASL hands back what
+ * the user typed or browsed to: an empty drawer (the current directory) or a
+ * relative one ("/out dir") is resolved against the current directory, which
+ * the opener of the file does not share (a program started from Workbench
+ * runs in its own drawer). Falls back to the drawer as given.
+ */
+static void absolute_drawer(const char *drawer, char *buf, LONG size)
+{
+    BPTR lock;
+    buf[0] = 0;
+    if (!drawer)
+        drawer = "";
+    lock = Lock((CONST_STRPTR)drawer, SHARED_LOCK);
+    if (lock) {
+        BOOL ok = NameFromLock(lock, (STRPTR)buf, size);
+        UnLock(lock);
+        if (ok)
+            return;
+    }
+    strncpy(buf, drawer, size - 1);
+    buf[size - 1] = 0;
+}
+
+/*
+ * An ASL file requester. `save` selects save mode, `multi` multi-selection;
+ * `dir`, `file` and `pattern` may be empty. The chosen paths are written to
+ * `out`, separated by newlines; returns the number of paths (0: cancelled or
+ * nothing fits).
+ */
+int32_t wc_file_request(struct wc_window *w, int32_t save, int32_t multi, const char *title,
+                        const char *dir, const char *file, const char *pattern, char *out, int32_t outlen)
+{
+    struct FileRequester *req;
+    int32_t count = 0;
+    char path[1024];
+
+    if (!out || outlen < 2)
+        return 0;
+    out[0] = 0;
+    req = AllocAslRequestTags(ASL_FileRequest,
+        ASLFR_Window, (IPTR)(w ? w->win : NULL),
+        ASLFR_TitleText, (IPTR)(title ? title : "Select file"),
+        ASLFR_InitialDrawer, (IPTR)(dir ? dir : ""),
+        ASLFR_InitialFile, (IPTR)(file ? file : ""),
+        ASLFR_DoSaveMode, save ? TRUE : FALSE,
+        ASLFR_DoMultiSelect, (multi == 1 && !save) ? TRUE : FALSE,
+        ASLFR_DrawersOnly, multi == 2 ? TRUE : FALSE,
+        ASLFR_DoPatterns, (pattern && pattern[0]) ? TRUE : FALSE,
+        ASLFR_InitialPattern, (IPTR)((pattern && pattern[0]) ? pattern : "#?"),
+        ASLFR_RejectIcons, TRUE,
+        TAG_DONE);
+    if (!req)
+        return 0;
+    if (AslRequestTags(req, TAG_DONE)) {
+        if (multi == 2) {
+            absolute_drawer((const char *)req->fr_Drawer, path, sizeof path);
+            if (strlen(path) + 1 <= (size_t)outlen) { strcpy(out, path); count = 1; }
+        } else if (multi == 1 && !save && req->fr_NumArgs > 0) {
+            LONG i;
+            for (i = 0; i < req->fr_NumArgs; i++) {
+                absolute_drawer((const char *)req->fr_Drawer, path, sizeof path);
+                if (!AddPart((STRPTR)path, (CONST_STRPTR)req->fr_ArgList[i].wa_Name, sizeof path))
+                    continue;
+                if (strlen(out) + strlen(path) + 2 > (size_t)outlen)
+                    break;
+                if (count)
+                    strcat(out, "\n");
+                strcat(out, path);
+                count++;
+            }
+        } else if (req->fr_File && req->fr_File[0]) {
+            absolute_drawer((const char *)req->fr_Drawer, path, sizeof path);
+            if (AddPart((STRPTR)path, (CONST_STRPTR)req->fr_File, sizeof path) && strlen(path) + 1 <= (size_t)outlen) {
+                strcpy(out, path);
+                count = 1;
+            }
+        }
+    }
+    FreeAslRequest(req);
+    return count;
+}
+
+/* Writes `len` bytes of text (system charset) to the clipboard as FTXT. */
+int32_t wc_clip_write_text(const char *text, int32_t len)
+{
+    struct IFFHandle *iff = AllocIFF();
+    int32_t ok = 0;
+    if (!iff)
+        return 0;
+    iff->iff_Stream = (IPTR)OpenClipboard(0);
+    if (iff->iff_Stream) {
+        InitIFFasClip(iff);
+        if (OpenIFF(iff, IFFF_WRITE) == 0) {
+            if (PushChunk(iff, ID_FTXT, ID_FORM, IFFSIZE_UNKNOWN) == 0) {
+                if (PushChunk(iff, 0, ID_CHRS, len) == 0) {
+                    ok = WriteChunkBytes(iff, (APTR)text, len) == len;
+                    PopChunk(iff);
+                }
+                PopChunk(iff);
+            }
+            CloseIFF(iff);
+        }
+        CloseClipboard((struct ClipboardHandle *)iff->iff_Stream);
+    }
+    FreeIFF(iff);
+    return ok;
+}
+
+/* Reads the clipboard's FTXT text into `out` (NUL ended); returns its length, or 0. */
+int32_t wc_clip_read_text(char *out, int32_t outlen)
+{
+    struct IFFHandle *iff = AllocIFF();
+    int32_t total = 0;
+    if (!iff || !out || outlen < 1)
+        return 0;
+    out[0] = 0;
+    iff->iff_Stream = (IPTR)OpenClipboard(0);
+    if (iff->iff_Stream) {
+        InitIFFasClip(iff);
+        if (OpenIFF(iff, IFFF_READ) == 0) {
+            if (StopChunk(iff, ID_FTXT, ID_CHRS) == 0) {
+                while (ParseIFF(iff, IFFPARSE_SCAN) == 0) {
+                    struct ContextNode *cn = CurrentChunk(iff);
+                    if (cn && cn->cn_Type == ID_FTXT && cn->cn_ID == ID_CHRS) {
+                        LONG want = cn->cn_Size;
+                        if (want > outlen - 1 - total)
+                            want = outlen - 1 - total;
+                        if (want > 0) {
+                            LONG got = ReadChunkBytes(iff, out + total, want);
+                            if (got > 0)
+                                total += got;
+                        }
+                    }
+                }
+            }
+            CloseIFF(iff);
+        }
+        CloseClipboard((struct ClipboardHandle *)iff->iff_Stream);
+    }
+    FreeIFF(iff);
+    out[total] = 0;
+    return total;
+}
+
+/* Hands a URL to the system's OpenURL command (openurl.library's front end).
+ * The Rust side percent-encodes quotes, `*`, spaces and control bytes, so the
+ * URL cannot end the quoted argument; anything else is refused here too.
+ * SystemTags gives the command a DupLock of our PROGDIR: (pr_HomeDir) that it
+ * may never release, which keeps the program's drawer "in use" until reboot;
+ * on ABIv11 SystemTags drops an NP_HomeDir tag, so the home directory is
+ * cleared for the duration of the call instead. */
+int32_t wc_open_url(const char *url)
+{
+    char cmd[2048];
+    const char *p;
+    struct Process *me = (struct Process *)FindTask(NULL);
+    BPTR home;
+    LONG rc;
+    if (!url || strlen(url) > sizeof cmd - 16)
+        return 0;
+    for (p = url; *p; p++)
+        if (*p == '"' || *p == '*' || (unsigned char)*p <= ' ' || (unsigned char)*p >= 0x7f)
+            return 0;
+    strcpy(cmd, "OpenURL \"");
+    strcat(cmd, url);
+    strcat(cmd, "\"");
+    home = me->pr_HomeDir;
+    me->pr_HomeDir = BNULL;
+    rc = SystemTags((CONST_STRPTR)cmd, SYS_Asynch, FALSE, TAG_DONE);
+    me->pr_HomeDir = home;
+    return rc == 0;
+}
+
+int32_t wc_debug_tasks(char *out, int32_t outlen);
+
+/* Diagnostics: every task exec knows of (this one, the ready and the waiting
+ * ones) as "name|state|pri|sigwait|sigrecvd" lines. Used to see which threads
+ * are still alive when the program exits: AROS's pthread library waits for
+ * all of them. Returns the number of bytes written to `out`. */
+static int32_t append_task(char *out, int32_t outlen, int32_t len, struct Task *t, const char *state)
+{
+    int n;
+    if (len >= outlen - 1)
+        return len;
+    n = snprintf(out + len, outlen - len, "%s|%s|%d|%08lx|%08lx\n",
+                 t->tc_Node.ln_Name ? t->tc_Node.ln_Name : "?", state, (int)t->tc_Node.ln_Pri,
+                 (unsigned long)t->tc_SigWait, (unsigned long)t->tc_SigRecvd);
+    if (n < 0)
+        return len;
+    return len + n < outlen ? len + n : outlen - 1;
+}
+
+/* Words on a waiting pthread's stack that point into this program's code:
+ * candidate return addresses, which the host maps to functions with nm after
+ * subtracting the anchor's load offset. A heuristic stack scan, diagnostics only. */
+static int32_t append_stack(char *out, int32_t outlen, int32_t len, struct Task *t)
+{
+    IPTR lo = (IPTR)&wc_debug_tasks - 0x4000000, hi = (IPTR)&wc_debug_tasks + 0x4000000;
+    IPTR *sp = (IPTR *)t->tc_SPReg, *top = (IPTR *)t->tc_SPUpper;
+    int found = 0, n;
+    if (!sp || !top || sp >= top || top - sp > 65536)
+        return len;
+    for (; sp < top && found < 48 && len < outlen - 24; sp++) {
+        if (*sp >= lo && *sp < hi) {
+            n = snprintf(out + len, outlen - len, " %lx", (unsigned long)*sp);
+            if (n > 0)
+                len += n;
+            found++;
+        }
+    }
+    if (len < outlen - 1) {
+        out[len++] = '\n';
+        out[len] = 0;
+    }
+    return len;
+}
+
+int32_t wc_debug_tasks(char *out, int32_t outlen)
+{
+    struct Node *n;
+    int32_t len = 0;
+    if (!out || outlen < 2)
+        return 0;
+    out[0] = 0;
+    len = snprintf(out, outlen, "anchor wc_debug_tasks=%lx\n", (unsigned long)(IPTR)&wc_debug_tasks);
+    Forbid();
+    len = append_task(out, outlen, len, FindTask(NULL), "running");
+    for (n = SysBase->TaskReady.lh_Head; n->ln_Succ; n = n->ln_Succ)
+        len = append_task(out, outlen, len, (struct Task *)n, "ready");
+    for (n = SysBase->TaskWait.lh_Head; n->ln_Succ; n = n->ln_Succ) {
+        len = append_task(out, outlen, len, (struct Task *)n, "wait");
+        if (n->ln_Name && strncmp(n->ln_Name, "pthread", 7) == 0)
+            len = append_stack(out, outlen, len, (struct Task *)n);
+    }
+    Permit();
+    return len;
+}
