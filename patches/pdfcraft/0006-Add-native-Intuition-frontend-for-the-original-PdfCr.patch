+//! rfd-shaped adapter for the AROS shell. ASL runs on the calling UI task;
+//! only a completed choice is sent to the existing picker worker.
+use std::future::{Ready, ready};
+use std::path::{Path, PathBuf};
+use std::sync::OnceLock;
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Kind {
+    Open,
+    Many,
+    Save,
+    Folder,
+}
+#[derive(Clone, Debug)]
+pub struct Request {
+    pub kind: Kind,
+    pub title: String,
+    pub directory: PathBuf,
+    pub file_name: String,
+    pub filters: Vec<(String, Vec<String>)>,
+}
+type Handler = fn(Request) -> Option<Vec<PathBuf>>;
+static HANDLER: OnceLock<Handler> = OnceLock::new();
+/// Install the shell callback once, before creating the application.
+pub fn install(handler: Handler) -> Result<(), &'static str> {
+    HANDLER.set(handler).map_err(|_| "file-dialog handler already installed")
+}
+#[derive(Clone, Debug)]
+pub struct AsyncFileDialog {
+    request: Request,
+}
+impl Default for AsyncFileDialog {
+    fn default() -> Self {
+        Self::new()
+    }
+}
+impl AsyncFileDialog {
+    pub fn new() -> Self {
+        Self { request: Request { kind: Kind::Open, title: String::new(), directory: PathBuf::new(), file_name: String::new(), filters: Vec::new() } }
+    }
+    pub fn set_title(mut self, title: impl Into<String>) -> Self {
+        self.request.title = title.into();
+        self
+    }
+    pub fn set_file_name(mut self, name: impl Into<String>) -> Self {
+        self.request.file_name = name.into();
+        self
+    }
+    pub fn set_directory(mut self, path: impl AsRef<Path>) -> Self {
+        self.request.directory = path.as_ref().into();
+        self
+    }
+    pub fn add_filter(mut self, name: impl Into<String>, extensions: &[impl AsRef<str>]) -> Self {
+        self.request.filters.push((name.into(), extensions.iter().map(|s| s.as_ref().to_owned()).collect()));
+        self
+    }
+    fn choose(mut self, kind: Kind) -> Option<Vec<FileHandle>> {
+        self.request.kind = kind;
+        HANDLER.get().and_then(|handler| handler(self.request)).map(|paths| paths.into_iter().map(FileHandle).collect())
+    }
+    pub fn pick_file(self) -> Ready<Option<FileHandle>> {
+        ready(self.choose(Kind::Open).and_then(|v| v.into_iter().next()))
+    }
+    pub fn pick_files(self) -> Ready<Option<Vec<FileHandle>>> {
+        ready(self.choose(Kind::Many))
+    }
+    pub fn pick_folder(self) -> Ready<Option<FileHandle>> {
+        ready(self.choose(Kind::Folder).and_then(|v| v.into_iter().next()))
+    }
+    pub fn save_file(self) -> Ready<Option<FileHandle>> {
+        ready(self.choose(Kind::Save).and_then(|v| v.into_iter().next()))
+    }
+}
+#[derive(Clone, Debug)]
+pub struct FileHandle(PathBuf);
+impl FileHandle {
+    pub fn path(&self) -> &Path {
+        &self.0
+    }
+    pub fn file_name(&self) -> String {
+        self.0.file_name().map(|s| s.to_string_lossy().into_owned()).unwrap_or_default()
+    }
+}
diff --git a/crates/aros-dialog/tests/contract.rs b/crates/aros-dialog/tests/contract.rs
new file mode 100644
index 0000000000000000000000000000000000000000..3d2ffeac1b83af24ad245ee750142a31537d673e
--- /dev/null
+++ b/crates/aros-dialog/tests/contract.rs
@@ -0,0 +1,17 @@
+use pdfcraft_aros_dialog::{AsyncFileDialog, Kind, install};
+use std::sync::atomic::{AtomicUsize, Ordering};
+static CALLS: AtomicUsize = AtomicUsize::new(0);
+#[test]
+fn native_request_is_performed_before_future_moves_to_worker() {
+    install(|request| {
+        assert_eq!(request.kind, Kind::Open);
+        assert_eq!(request.title, "Open PDF");
+        assert_eq!(request.filters[0].1, ["pdf"]);
+        CALLS.fetch_add(1, Ordering::SeqCst);
+        Some(vec!["/RAM/example.pdf".into()])
+    })
+    .unwrap();
+    let future = AsyncFileDialog::new().set_title("Open PDF").add_filter("PDF", &["pdf"]).pick_file();
+    assert_eq!(CALLS.load(Ordering::SeqCst), 1, "ASL must run before the future is sent to another task");
+    drop(future);
+}
