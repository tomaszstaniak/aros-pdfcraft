From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: tomaszstaniak <68373859+tomaszstaniak@users.noreply.github.com>
Date: Sun, 18 Oct 2026 12:00:45 +0200
Subject: [PATCH] AROS: use SDK local time and restore task requester state

Native -nix run exposed a blocking etc: timezone requester. Use localtime_r and a non-Send requester guard set before workers and restored after joining. C glue builds against explicit matching SDK/compiler. Native follow-up pending; no shared Rust runtime changed.
---
 apps/pdfcraft-cli/src/main.rs   |  1 +
 crates/aros-runtime/Cargo.toml  |  1 +
 crates/aros-runtime/build.rs    | 30 +++++++++++++++++++++
 crates/aros-runtime/c/runtime.c | 14 ++++++++++
 crates/aros-runtime/src/lib.rs  | 46 +++++++++++++++++++++++++++++++++
 crates/engine/Cargo.toml        |  3 +++
 crates/engine/src/lib.rs        |  4 ++-
 7 files changed, 98 insertions(+), 1 deletion(-)
 create mode 100644 crates/aros-runtime/build.rs
 create mode 100644 crates/aros-runtime/c/runtime.c

diff --git a/apps/pdfcraft-cli/src/main.rs b/apps/pdfcraft-cli/src/main.rs
index f02fc4d1da401e634c2128897e17786882a90f2f..f1413b813dd97f98bac0ade617444ad934f763d2 100644
--- a/apps/pdfcraft-cli/src/main.rs
+++ b/apps/pdfcraft-cli/src/main.rs
@@ -89,6 +89,7 @@ fn main() -> ExitCode {
     }
     #[cfg(target_os = "aros")]
     {
+        let _requesters = pdfcraft_aros_runtime::suppress_requesters();
         // The starter's Shell/Workbench stack is too small for nested PDF work.
         // Join before shutting down Rayon, so no command submits work afterwards.
         let result = std::thread::Builder::new().name("pdfcraft-cli".into()).stack_size(2 * 1024 * 1024).spawn(run_cli);
