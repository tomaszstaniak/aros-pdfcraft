From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: tomaszstaniak <68373859+tomaszstaniak@users.noreply.github.com>
Date: Mon, 23 Nov 2026 16:09:39 +0100
Subject: [PATCH] AROS: build without the self-updater

---
 crates/ui-egui/Cargo.toml              |  6 ++-
 crates/ui-egui/src/lib.rs              |  2 +-
 crates/ui-egui/src/platform/updates.rs | 53 ++++++++++++++------------
 3 files changed, 35 insertions(+), 26 deletions(-)

diff --git a/crates/ui-egui/Cargo.toml b/crates/ui-egui/Cargo.toml
index d77cd62188b9d0a0d2347d2bc7d8cb2efe8afb37..cc5231dad55f03e953ad2fca109eb656831c20e9 100644
--- a/crates/ui-egui/Cargo.toml
+++ b/crates/ui-egui/Cargo.toml
@@ -54,8 +54,12 @@ unicode-bidi = "0.3"
 # that put fallback faces on the interface's baseline (#1676); the same skrifa egui uses.
 skrifa = "0.44"
 
-[target.'cfg(not(target_arch = "wasm32"))'.dependencies]
+# AROS: no self-update. Releases come through the AROS package catalogue, and the updater's
+# HTTPS stack (hyper, rustls) has no AROS build.
+[target.'cfg(not(any(target_arch = "wasm32", target_os = "aros")))'.dependencies]
 craft-update = { workspace = true }
+
+[target.'cfg(not(target_arch = "wasm32"))'.dependencies]
 # Control-channel tokens.
 getrandom = "0.4"
 # Create ▸ Clipboard (images; already in the tree through egui-winit).
