From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: tomaszstaniak <68373859+tomaszstaniak@users.noreply.github.com>
Date: Sun, 18 Oct 2026 11:38:16 +0200
Subject: [PATCH] Saves: retain staged contents after a destructive rename
 failure

Reuse the PhotoCraft failure model: SDK rename can delete the previous destination before failing. Add an injected delete-then-fail regression, observed failing before cleanup protection; all 14 platform tests then pass on host. Native failed-save injection remains unverified. Local-only; candidate for upstream review.
---
 crates/platform/src/staging.rs | 51 ++++++++++++++++++++++++++++++++--
 1 file changed, 48 insertions(+), 3 deletions(-)

diff --git a/crates/platform/src/staging.rs b/crates/platform/src/staging.rs
index f7200efb9ee2b7909f9887b08e2fb84cccc9a6ca..d1965a5e83d68b2a73bf575123c2c477914724a2 100644
--- a/crates/platform/src/staging.rs
+++ b/crates/platform/src/staging.rs
@@ -83,11 +83,23 @@ pub fn write_atomically_with(
     form: StagingName,
     suffixes: impl IntoIterator<Item = u64>,
     sync_all: impl FnOnce(&std::fs::File) -> std::io::Result<()>,
+) -> std::io::Result<()> {
+    write_atomically_using(path, bytes, form, suffixes, sync_all, |from, to| std::fs::rename(from, to))
+}
+
+fn write_atomically_using(
+    path: &Path,
+    bytes: &[u8],
+    form: StagingName,
+    suffixes: impl IntoIterator<Item = u64>,
+    sync_all: impl FnOnce(&std::fs::File) -> std::io::Result<()>,
+    rename: impl FnOnce(&Path, &Path) -> std::io::Result<()>,
 ) -> std::io::Result<()> {
     use std::io::Write as _;
     let dir = path.parent().filter(|d| !d.as_os_str().is_empty()).unwrap_or(Path::new("."));
     let name = path.file_name().and_then(|n| n.to_str()).unwrap_or("save");
     let (tmp, file) = create_staging(dir, name, form, suffixes)?;
+    let replacing = path.symlink_metadata().is_ok();
     let result = (|| {
         // Closed at the end of the block, before the rename (required on Windows).
         {
@@ -95,12 +107,21 @@ pub fn write_atomically_with(
             file.write_all(bytes)?;
             sync_staged(&file, sync_all)?;
         }
-        std::fs::rename(&tmp, path)
+        rename(&tmp, path)
     })();
-    if result.is_err() {
+    if let Err(error) = result {
+        // Some AROS CRTs delete the destination before attempting Rename().
+        // If that second step fails, the staging file holds the only new copy.
+        if replacing && path.symlink_metadata().is_err() && tmp.symlink_metadata().is_ok() {
+            return Err(std::io::Error::new(
+                error.kind(),
+                format!("cannot save {}: {error}; the previous file was removed; new contents retained at {}", path.display(), tmp.display()),
+            ));
+        }
         let _ = std::fs::remove_file(&tmp);
+        return Err(error);
     }
-    result
+    Ok(())
 }
 
 /// Flush the staging file to the disk before it replaces the target. On macOS `sync_all` asks
@@ -215,4 +236,28 @@ mod tests {
         assert_eq!(names(&dir), ["out.pdf"]);
         let _ = std::fs::remove_dir_all(&dir);
     }
+
+    #[test]
+    fn a_delete_then_failed_rename_retains_the_only_new_copy() {
+        let dir = test_dir("delete-then-fail");
+        let target = dir.join("out.pdf");
+        std::fs::write(&target, b"OLD").unwrap();
+        let error = write_atomically_using(
+            &target,
+            b"NEW",
+            StagingName::SuffixThenTag,
+            [42],
+            |_| Ok(()),
+            |_, to| {
+                std::fs::remove_file(to)?;
+                Err(std::io::Error::other("injected delete-then-fail"))
+            },
+        )
+        .unwrap_err();
+        let remaining: Vec<_> = std::fs::read_dir(&dir).unwrap().map(|e| e.unwrap().path()).collect();
+        assert_eq!(remaining.len(), 1, "the only new copy must survive a destructive SDK rename failure");
+        assert_eq!(std::fs::read(&remaining[0]).unwrap(), b"NEW");
+        assert!(error.to_string().contains(&remaining[0].display().to_string()));
+        std::fs::remove_dir_all(dir).unwrap();
+    }
 }
